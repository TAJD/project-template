# Feedback widget (apps/web/src/modules/feedback) — unset either var and the
# widget renders nothing. VITE_* vars are baked into the client bundle at
# build time, so VITE_FEEDBACK_TOKEN is public by design (a lightweight
# anti-spam token, not a secret). See docs/modules/feedback.md.
VITE_FEEDBACK_ENDPOINT=
VITE_FEEDBACK_TOKEN=
