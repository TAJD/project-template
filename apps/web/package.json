{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-public-assets.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/generate-og.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feeds.mjs && node scripts/generate-worker-routes.mjs && pnpm exec pagefind --site dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@template/shared": "workspace:*",
    "autoprefixer": "^10.5.4",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "pagefind": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
